# ---- Core ----
APP_URL=http://localhost:3000
# 32+ random characters. Used for token hashing, signing and encryption at rest.
APP_SECRET=
# Supabase: use the *session pooler* or direct connection string (Settings → Database).
DATABASE_URL=postgres://user:pass@host:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5
# Used by the worker to reach the web app for cache invalidation (e.g. http://web:3000 in Docker)
INTERNAL_APP_URL=

# ---- Auth: local | supabase ----
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Payments (Paystack). Use sk_test_ keys until live payments are approved. ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENTS_LIVE_APPROVED=false

# ---- Email (any SMTP provider) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- SMS (optional, mNotify) ----
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=

# ---- Storage: r2 | local (local is development only) ----
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# ---- Integrations (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- AI assistant (optional, off by default) ----
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MONTHLY_REQUEST_LIMIT=300

DEMO_BANNER=false
