# =============================================================================
# Infrastructure-level configuration ONLY.
# Business integrations (Paystack, Hubtel, SMTP, Cloudflare R2, Google
# Calendar/Meet, Zoom, mNotify, AI) are configured by the client in
# Studio → Settings → Integrations and stored encrypted in PostgreSQL.
# Never commit a filled-in copy of this file.
# =============================================================================

NODE_ENV=production
# Public HTTPS URL of this deployment (staging or production).
APP_URL=https://staging.example.com
# 48+ random characters: openssl rand -base64 48
# Used for session-token hashing, signed links and MFA secret encryption.
APP_SECRET=

# ---- PostgreSQL (dedicated database + least-privilege role for this app) ----
# Keep the database on the private Docker network; never publish port 5432.
# The private PostgreSQL container in this stack, least-privilege role created on first boot.
DATABASE_URL=postgres://brand_app:CHANGE_ME_SAME_AS_secrets/app_db_password@postgres:5432/brand_platform
DATABASE_SSL=false
# Only for a managed database whose certificate chain is self-signed.
DATABASE_SSL_ALLOW_SELF_SIGNED=false
DATABASE_POOL_MAX=5

# ---- Credential encryption master key(s) for the Integration Centre ----
# Comma-separated "version:base64key" pairs. FIRST entry encrypts new values;
# older entries stay only until `pnpm credentials:rotate` has run.
# Generate a key: openssl rand -base64 32
# Back this up OFFLINE, separately from database backups — without it, stored
# integration credentials cannot be decrypted (they would need re-entering).
CREDENTIALS_MASTER_KEYS=1:

# ---- Go-live controls (operator decisions, not CRM-editable) ----
# Live payment keys (and Hubtel, which has no test mode) stay locked until true.
PAYMENTS_LIVE_APPROVED=false
# Staff must enrol in two-factor authentication. Defaults to true in production.
STAFF_MFA_REQUIRED=true

# ---- Local file storage (fallback until Cloudflare R2 is connected) ----
# In production, local storage is refused unless explicitly allowed (staging).
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
LOCAL_STORAGE_DIR=/app/.data/storage

# ---- Network safety ----
# Hostnames allowed to resolve to private IPs (e.g. an SMTP relay on the private network).
ALLOWED_PRIVATE_HOSTS=

# Worker → web cache invalidation (Docker service name).
INTERNAL_APP_URL=http://web:3000

# Shows a "Demonstration content" ribbon. Staging only.
DEMO_BANNER=false
