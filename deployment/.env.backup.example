# Backup-only secrets (deployment/.env.backup, chmod 600). Infrastructure level — not editable in Studio.
# Passphrase that encrypts every backup file. Keep a copy OFFLINE (password manager) — without it backups are unreadable.
BACKUP_PASSPHRASE=
# Maintenance connection used ONLY to create/drop throwaway restore-test databases (never restores into the live DB).
ADMIN_DATABASE_URL=postgres://brand_admin:CHANGE_ME@postgres:5432/postgres
# Dedicated R2 bucket + API token scoped to that bucket only (Object Read & Write). Separate from the client's media bucket.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Optional: healthchecks.io-compatible URL pinged on success (and /fail on failure).
HEALTHCHECK_URL=
BACKUP_KEEP=14
REMOTE_KEEP_DAYS=35
